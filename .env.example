# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider (pick one)
GEMINI_API_KEY=           # Gemini API
LLM_MODEL=gemini-3.1-flash-lite
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM — overrides Gemini when set

# Auto-Apply (optional)
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass

# Referral outreach via OpenOutreach (optional)
# OPENOUTREACH_BASE_URL=http://127.0.0.1:8741/v1
# OPENOUTREACH_API_KEY=
# OPENOUTREACH_CAMPAIGN=job-referrals
